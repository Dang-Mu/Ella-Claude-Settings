prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["git", "push"], decision="allow")
prefix_rule(pattern=["npm", "run", "test:server"], decision="allow")
prefix_rule(pattern=["npm", "run", "test"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["git", "commit"], decision="allow")
prefix_rule(pattern=["postgres", "-D", "/tmp/mongle-session-pg"], decision="allow")
prefix_rule(pattern=["psql", "-h", "/tmp", "-p", "55432"], decision="allow")
prefix_rule(pattern=["node", "--env-file-if-exists=.env.local", "--import", "tsx/esm", "--test"], decision="allow")
